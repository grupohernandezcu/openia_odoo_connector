<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Canal OpenIA -->
        <record model="mail.channel" id="channel_openia">
            <field name="name">OpenIA</field>
            <field name="description">OpenIA Integration</field>
            <field name="image_128" type="base64" file="openia_odoo_connector/static/description/openia.png"/>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Mensaje de bienvenida en el canal -->
        <record model="mail.message" id="module_install_notification">
            <field name="model">mail.channel</field>
            <field name="res_id" ref="channel_openia"/>
            <field name="message_type">email</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field name="subject">Welcome to OpenIA Channel!</field>
            <field name="body"><![CDATA[
                <p>Welcome to the #OpenIA channel.</p>
                <p>Ask your questions to OpenIA.</p>
            ]]></field>
        </record>

        <!-- Miembro admin en el canal 
        <record id="channel_member_openia_admin" model="mail.channel.member">
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="channel_id" ref="channel_openia"/>
            <field name="fetched_message_id" ref="module_install_notification"/>
            <field name="seen_message_id" ref="module_install_notification"/> 
        </record> -->
        
    </data>
</odoo>