<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="openia_chatgpt_default" model="openia">
            <field name="name">ChatGPT Default</field>
            <field name="base_url">https://api.openai.com/v1</field>
            <field name="api_key">your_chatgpt_api_key_here</field>
            <field name="general_message_prompt">You are a helpful assistant ready to answer user queries accurately and politely.</field>
            <field name="message_model">gpt-4o-mini</field>
            <field name="conversation_message_prompt">You are a helpful assistant ready to answer user queries accurately and politely.</field>
            <field name="conversation_model">gpt-4o-mini</field>
            <field name="editing_model">text-davinci-edit-001</field>
            <field name="converting_model">whisper-1</field>
            <field name="image_model">dall-e-3</field>
            <field name="temperature">0.5</field>
            <field name="top_p">1.0</field>
            <field name="frequency_penalty">0.0</field>
            <field name="presence_penalty">0.0</field>
            <field name="max_tokens">1000</field>
            <field name="stop_sequences">"""</field>
        </record>

        <record id="openia_deepseek_default" model="openia">
            <field name="name">Deepseek Default</field>
            <field name="base_url">https://api.deepseek.ai/v1</field>
            <field name="api_key">your_deepseek_api_key_here</field>
            <field name="general_message_prompt">You are an AI assistant specialized in search and knowledge retrieval to assist users.</field>
            <field name="message_model">deepseek-text-model</field>
            <field name="conversation_message_prompt">You are a helpful assistant ready to answer user queries accurately and politely.</field>
            <field name="conversation_model">deepseek-text-model</field>
            <field name="editing_model">deepseek-edit-model</field>
            <field name="converting_model">deepseek-audio-model</field>
            <field name="image_model">deepseek-image-model</field>
            <field name="temperature">0.7</field>
            <field name="top_p">1.0</field>
            <field name="frequency_penalty">0.0</field>
            <field name="presence_penalty">0.0</field>
            <field name="max_tokens">1500</field>
            <field name="stop_sequences">"""</field>
        </record>
        
    </data>
</odoo>
